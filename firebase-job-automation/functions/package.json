{
    "name": "firebase-job-automation",
    "version": "1.0.0",
    "description": "Automated job posting system for social media platforms",
    "main": "lib/index.js",
    "scripts": {
      "build": "tsc",
      "serve": "npm run build && firebase emulators:start --only functions",
      "shell": "npm run build && firebase functions:shell",
      "start": "npm run shell",
      "deploy": "firebase deploy --only functions",
      "logs": "firebase functions:log",
      "test": "jest"
    },
    "dependencies": {
      "firebase-admin": "^11.11.0",
      "firebase-functions": "^4.5.0",
      "axios": "^1.6.0",
      "twitter-api-v2": "^1.15.2",
      "dotenv": "^16.3.1",
      "node-html-parser": "^6.1.10"
    },
    "devDependencies": {
      "@types/node": "^20.8.0",
      "typescript": "^5.2.2",
      "jest": "^29.7.0",
      "@types/jest": "^29.5.4",
      "ts-jest": "^29.1.1",
      "firebase-functions-test": "^3.1.0"
    },
    "private": true,
    "engines": {
      "node": "18"
    }
  }